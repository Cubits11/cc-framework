{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cc-framework.local/schemas/cc_report.schema.json",
  "title": "CC Report v0.3.1",
  "description": "Machine-checkable receipt for one scoped CC claim. The schema fixes the report version, evidence hashes, allowed claim level, explicit non-claims, and canonical receipt fields without certifying production safety.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "created_at",
    "framework_version",
    "git",
    "environment",
    "run",
    "assumptions",
    "calibration",
    "measurement",
    "evidence",
    "claim",
    "receipt"
  ],
  "properties": {
    "schema_version": {
      "description": "Report contract version. A verifier should treat a different value as a different receipt contract.",
      "const": "cc.report.v0.3.1"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "framework_version": {
      "type": "string",
      "minLength": 1
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty", "branch"],
      "properties": {
        "commit": {
          "type": ["string", "null"]
        },
        "dirty": {
          "type": "boolean"
        },
        "branch": {
          "type": ["string", "null"]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_version", "platform"],
      "properties": {
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "dependency_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "package_snapshot": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "config_path", "config_hash", "seed", "command"],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "config_path": {
          "type": ["string", "null"]
        },
        "config_hash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "seed": {
          "type": ["integer", "null"]
        },
        "command": {
          "type": ["string", "null"]
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_fpr",
        "alpha_cap",
        "realized_fpr",
        "calibration_window",
        "threshold",
        "status"
      ],
      "properties": {
        "target_fpr": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "alpha_cap": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "realized_fpr": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "calibration_window": {
          "type": "object"
        },
        "threshold": {
          "type": ["number", "null"]
        },
        "status": {
          "enum": ["pass", "fail"]
        }
      },
      "anyOf": [
        {
          "properties": {
            "target_fpr": {
              "type": "number"
            }
          }
        },
        {
          "properties": {
            "alpha_cap": {
              "type": "number"
            }
          }
        }
      ]
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_family",
        "point_estimate",
        "interval",
        "confidence_level",
        "delta",
        "interval_method",
        "sample_sizes"
      ],
      "properties": {
        "metric_family": {
          "type": "string",
          "minLength": 1
        },
        "point_estimate": {
          "type": "number"
        },
        "interval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lower", "upper"],
          "properties": {
            "lower": {
              "type": "number"
            },
            "upper": {
              "type": "number"
            }
          }
        },
        "confidence_level": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "delta": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "interval_method": {
          "type": "string",
          "minLength": 1
        },
        "sample_sizes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "confidence_level": {
              "type": "number"
            }
          }
        },
        {
          "properties": {
            "delta": {
              "type": "number"
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "description": "Evidence references bound by SHA-256 hashes. These hashes identify bytes for audit; they do not prove that the evidence is sufficient for release or compliance.",
      "additionalProperties": false,
      "required": ["artifacts", "audit_log", "figure_manifest"],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_artifact"
          }
        },
        "audit_log": {
          "oneOf": [
            {
              "$ref": "#/$defs/evidence_artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "figure_manifest": {
          "oneOf": [
            {
              "$ref": "#/$defs/evidence_artifact"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "description": "The single claim this report is allowed to support, plus explicit boundaries on what the report does not claim.",
      "additionalProperties": false,
      "required": ["statement", "allowed_claim_level", "non_claims"],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "allowed_claim_level": {
          "$ref": "#/$defs/claim_level"
        },
        "non_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["allowed_claim_level"],
            "properties": {
              "allowed_claim_level": {
                "enum": ["bounded_empirical", "reproducible_run", "release_claim"]
              }
            }
          },
          "then": {
            "properties": {
              "non_claims": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "receipt": {
      "type": "object",
      "description": "Canonical SHA-256 receipt over the report JSON after excluding only receipt.canonical_hash.",
      "additionalProperties": false,
      "required": [
        "canonical_hash",
        "hash_algorithm",
        "canonicalization_method",
        "previous_hash"
      ],
      "properties": {
        "canonical_hash": {
          "description": "SHA-256 digest of the canonical report JSON with receipt.canonical_hash removed.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hash_algorithm": {
          "const": "sha256"
        },
        "canonicalization_method": {
          "description": "Exact deterministic JSON method used before hashing. All report fields except receipt.canonical_hash are included.",
          "const": "json.dumps(sort_keys=True,separators=(',', ':'),ensure_ascii=False,allow_nan=False); receipt.canonical_hash excluded"
        },
        "previous_hash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "claim_level": {
      "description": "Maximum claim strength the report is allowed to support. Reviewers may accept a weaker interpretation, but should not infer a stronger one from the receipt.",
      "oneOf": [
        {
          "const": "diagnostic",
          "description": "Exploratory or debugging evidence only; not a release, compliance, or safety claim."
        },
        {
          "const": "bounded_empirical",
          "description": "A measured bound or interval scoped to the named run, evaluation distribution, calibration window, and assumptions."
        },
        {
          "const": "reproducible_run",
          "description": "A receipt for rerunning or auditing the named run and artifacts; not a claim that conclusions transfer outside that setup."
        },
        {
          "const": "release_claim",
          "description": "A release-gate claim only within an external review process; not standalone certification of production safety or compliance."
        }
      ]
    },
    "evidence_artifact": {
      "type": "object",
      "description": "Named evidence file with its byte count and SHA-256 digest.",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "role"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
